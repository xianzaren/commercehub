# Copy to .env for local development. Never commit real credentials.
MYSQL_DATABASE=commercehub
MYSQL_USER=commercehub
MYSQL_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DATABASE_URL=mysql+pymysql://commercehub:replace-with-local-db-password@mysql:3306/commercehub?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://commercehub:replace-with-local-db-password@mysql:3306/commercehub_test?charset=utf8mb4
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=30
APP_ENV=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
